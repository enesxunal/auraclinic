# Aura Clinic — environment placeholders (no real secrets)
# Copy to Vercel Project Settings → Environment Variables

# Site
SITE_BASE_URL=https://auraclinicge.com
ALLOWED_ORIGINS=https://auraclinicge.com,https://www.auraclinicge.com

# SMTP (PrivateEmail / Namecheap)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@auraclinicge.com
SMTP_PASS=
MAIL_FROM=info@auraclinicge.com
MAIL_TO=info@auraclinicge.com

# Google Gemini (AI Hair Preview)
GEMINI_API_KEY=

# Meta Conversions API (Pixel ID is public in js/site-config.js)
META_PIXEL_ID=1745389426890785
META_CAPI_TOKEN=

# Optional: stronger rate limiting via Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate limit overrides
LEAD_RATE_LIMIT=8
PREVIEW_RATE_LIMIT=5

